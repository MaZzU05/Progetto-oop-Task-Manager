CompileFlags:
  Add:
    # Qt 6 include paths (Homebrew)
    - -I/opt/homebrew/include
    - -I/opt/homebrew/include/QtCore
    - -I/opt/homebrew/include/QtGui
    - -I/opt/homebrew/include/QtWidgets
    - -I/opt/homebrew/include/QtNetwork
    - -I/opt/homebrew/include/QtSql
    - -I/opt/homebrew/include/QtXml
    - -I/opt/homebrew/include/QtTest
    - -I/opt/homebrew/include/QtConcurrent
    - -I/opt/homebrew/include/QtPrintSupport
    # Project include paths
    - -I./modello
    - -I./modello/Filtri
    # Qt defines required for proper parsing
    - -DQT_CORE_LIB
    - -DQT_GUI_LIB
    - -DQT_WIDGETS_LIB
    - -DQT_NO_KEYWORDS
    # C++ standard
    - -std=c++17
  # Remove flags that clang doesn't understand from qmake
  Remove:
    - -Wno-documentation

Diagnostics:
  # Suppress noisy Qt macro warnings
  Suppress:
    - typecheck_incompatible_return_type_strict

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
