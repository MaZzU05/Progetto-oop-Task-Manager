QPushButton {
background-color: transparent;
padding: 5px;
border: 1px solid grey;
border-radius: 10px;
qproperty-iconSize: 24px 24px;
}

QPushButton:hover  {
background-color: lightblue;
}

QPushButton:pressed {
background-color: #e0e0e0;
border: 1px solid #b0b0b0;
}

gui--MainWindow QPushButton {
background-color: transparent;
padding: 5px;
border: 1px solid grey;
border-radius: 10px;
qproperty-iconSize: 24px 24px;
}

gui--MainWindow QPushButton:hover  {
background-color: lightblue;
}

gui--MainWindow QPushButton:pressed {
background-color: #e0e0e0;
border: 1px solid #b0b0b0;
}

gui--card--AbstractCardEdit QPushButton {
background-color: transparent;
padding: 5px;
border: 1px solid grey;
border-radius: 10px;
}
gui--card--AbstractCardEdit QPushButton:hover {
background-color: lightblue;
}
gui--card--AbstractCardEdit QPushButton:pressed {
background-color: #e0e0e0;
border: 1px solid #b0b0b0;
}

gui--card--CardAttivita {
background-color: white;
border: 1px solid #e0e0e0;
border-radius: 10px;
margin: 5px;
}
gui--card--CardAttivita:hover {
border: 1px solid #2196F3;
}
gui--card--CardAttivita QLabel {
color: #333333;
}
gui--card--CardAttivita QListWidget {
color: #333333;
background-color: transparent;
border: none;
}

gui--card--AbstractCardEdit QTextEdit {
border: 1px solid #e0e0e0;
border-radius: 10px;
padding: 10px;
background-color: transparent;
}

QProgressBar {
border: 1px solid grey;
border-radius: 5px;
text-align: center;
}
QProgressBar::chunk {
background-color: #4CAF50;
width: 10px;
margin: 1px;
}

QScrollArea {
background-color: transparent;
border: none;
}

